# Copy this file to demo/cicd/.env (gitignored, never committed) and fill in
# real values. Once this file exists, every demo script picks it up
# automatically -- no need to export anything by hand.

# Owner-role LiveReview API key for the org this demo runs against
# (Settings -> API Keys in the web UI).
LIVEREVIEW_API_KEY=

# That org's id (e.g. from the orgs table, or the URL when browsing the org
# in the LiveReview UI).
LIVEREVIEW_ORG_ID=

# The "Block on Critical or Security" ruleset's id. Leave blank the first
# time -- `make demo-cicd-setup` (or demo/cicd/create_ruleset.sh) creates the
# ruleset and prints this for you to paste in here.
LIVEREVIEW_RULESET_ID=
