{
  "_comment": "Version config for external binaries bundled in Docker images. Update consciously.",
  "vl-convert": {
    "version": "v1.9.0",
    "repo": "vega/vl-convert",
    "download_pattern": "https://github.com/{repo}/releases/download/{version}/vl-convert_{arch}.zip",
    "archs": {
      "amd64": "linux-64",
      "arm64": "linux-arm64"
    }
  },
  "codebase-memory-mcp": {
    "version": "v0.10.8",
    "repo": "DeusData/codebase-memory-mcp",
    "download_pattern": "https://github.com/{repo}/releases/download/{version}/codebase-memory-mcp-{arch}-portable.tar.gz",
    "archs": {
      "amd64": "linux-amd64",
      "arm64": "linux-arm64"
    }
  },
  "dbctx": {
    "version": "v0.1.0",
    "repo": "shrsv/dbctx",
    "build_from": "github.com/shrsv/dbctx/cmd/dbctx",
    "binary_name": "dbctx"
  },
  "alaws": {
    "version": "v0.1.0",
    "repo": "shrsv/AgentLaws",
    "build_from": "github.com/shrsv/AgentLaws/cmd/alaws",
    "binary_name": "alaws"
  }
}
