{
  "chart_types": [
    {
      "id": "bar",
      "name": "Bar Chart",
      "use_when": "Comparing categories, showing counts or aggregates per group",
      "data_shape": "categorical x, numeric y",
      "examples": ["reviews per trigger_type", "users per org", "top repositories by review count"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "x": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "-y"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "grouped_bar",
      "name": "Grouped Bar Chart",
      "use_when": "Comparing categories across two grouping dimensions",
      "data_shape": "category x, group color, numeric y",
      "examples": ["reviews per trigger_type split by month", "plan types per org"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "x": {"field": "CATEGORY_FIELD", "type": "nominal"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "color": {"field": "GROUP_FIELD", "type": "nominal"},
          "xOffset": {"field": "GROUP_FIELD"}
        }
      }
    },
    {
      "id": "stacked_bar",
      "name": "Stacked Bar Chart",
      "use_when": "Showing composition of categories, parts of a whole",
      "data_shape": "category x, subcategory color, numeric y",
      "examples": ["review status breakdown per month", "trigger type composition per org"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "x": {"field": "CATEGORY_FIELD", "type": "nominal"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative", "stack": "normalize"},
          "color": {"field": "SUBCATEGORY_FIELD", "type": "nominal"}
        }
      }
    },
    {
      "id": "line",
      "name": "Line Chart",
      "use_when": "Showing trends over time, continuous change",
      "data_shape": "temporal x, numeric y",
      "examples": ["reviews per month", "LOC consumed per billing period", "active users over time"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "line", "point": true},
        "encoding": {
          "x": {"field": "TIME_FIELD", "type": "temporal", "timeUnit": "yearmonthdate"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "tooltip": [{"field": "TIME_FIELD", "type": "temporal"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "multi_line",
      "name": "Multi-Series Line Chart",
      "use_when": "Comparing trends over time across groups",
      "data_shape": "temporal x, numeric y, group color",
      "examples": ["reviews per month per trigger_type", "LOC per billing period per provider"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "line", "point": true},
        "encoding": {
          "x": {"field": "TIME_FIELD", "type": "temporal", "timeUnit": "yearmonthdate"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "color": {"field": "GROUP_FIELD", "type": "nominal"},
          "tooltip": [{"field": "TIME_FIELD"}, {"field": "NUMERIC_FIELD"}, {"field": "GROUP_FIELD"}]
        }
      }
    },
    {
      "id": "area",
      "name": "Area Chart",
      "use_when": "Showing volume/magnitude over time, cumulative trends",
      "data_shape": "temporal x, numeric y",
      "examples": ["cumulative reviews over time", "total LOC consumed trend"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "area",
        "encoding": {
          "x": {"field": "TIME_FIELD", "type": "temporal", "timeUnit": "yearmonthdate"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"}
        }
      }
    },
    {
      "id": "stacked_area",
      "name": "Stacked Area Chart",
      "use_when": "Showing composition over time, how parts contribute to whole",
      "data_shape": "temporal x, numeric y, group color",
      "examples": ["review trigger type mix over time", "plan distribution over months"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "area",
        "encoding": {
          "x": {"field": "TIME_FIELD", "type": "temporal", "timeUnit": "yearmonthdate"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative", "stack": "normalize"},
          "color": {"field": "GROUP_FIELD", "type": "nominal"}
        }
      }
    },
    {
      "id": "scatter",
      "name": "Scatter Plot",
      "use_when": "Showing relationship/correlation between two numeric variables",
      "data_shape": "numeric x, numeric y, optional size/color",
      "examples": ["reviews vs LOC consumed per org", "users vs repositories per org"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "point",
        "encoding": {
          "x": {"field": "X_FIELD", "type": "quantitative"},
          "y": {"field": "Y_FIELD", "type": "quantitative"},
          "tooltip": [{"field": "X_FIELD"}, {"field": "Y_FIELD"}]
        }
      }
    },
    {
      "id": "pie",
      "name": "Pie / Donut Chart",
      "use_when": "Showing proportional composition of a whole (few categories)",
      "data_shape": "category, numeric value",
      "examples": ["plan type distribution", "trigger type share", "provider market share"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "arc", "innerRadius": 50},
        "encoding": {
          "theta": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "color": {"field": "CATEGORY_FIELD", "type": "nominal"},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "heatmap",
      "name": "Heatmap",
      "use_when": "Showing density or intensity across two categorical/temporal dimensions",
      "data_shape": "category/temporal x, category/temporal y, numeric color",
      "examples": ["review activity by day-of-week and hour", "org activity by month"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "rect",
        "encoding": {
          "x": {"field": "X_FIELD", "type": "ordinal"},
          "y": {"field": "Y_FIELD", "type": "ordinal"},
          "color": {"field": "NUMERIC_FIELD", "type": "quantitative", "scale": {"scheme": "blues"}},
          "tooltip": [{"field": "X_FIELD"}, {"field": "Y_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "horizontal_bar",
      "name": "Horizontal Bar Chart",
      "use_when": "Long category names, ranking items, leaderboard",
      "data_shape": "category y, numeric x",
      "examples": ["top reviewers", "top repositories", "orgs by review count"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "y": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "-x"},
          "x": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "boxplot",
      "name": "Box Plot",
      "use_when": "Showing distribution spread, median, outliers across categories",
      "data_shape": "category x, numeric y",
      "examples": ["LOC distribution per trigger_type", "review duration spread per provider"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "boxplot", "extent": 1.5},
        "encoding": {
          "x": {"field": "CATEGORY_FIELD", "type": "nominal"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"}
        }
      }
    },
    {
      "id": "trellis_bar",
      "name": "Trellis / Faceted Bar Chart",
      "use_when": "Comparing the same chart across many groups (small multiples)",
      "data_shape": "category x, numeric y, facet group",
      "examples": ["reviews per trigger_type per org", "monthly trend per provider"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "facet": {"field": "FACET_FIELD", "type": "nominal", "columns": 3},
        "spec": {
          "mark": "bar",
          "encoding": {
            "x": {"field": "CATEGORY_FIELD", "type": "nominal"},
            "y": {"field": "NUMERIC_FIELD", "type": "quantitative"}
          }
        }
      }
    },
    {
      "id": "histogram",
      "name": "Histogram",
      "use_when": "Showing how a numeric measure is distributed across many rows, as bucketed counts",
      "data_shape": "ordinal/binned x, numeric count y",
      "examples": ["reviews per commit, bucketed", "review duration distribution"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "bar", "color": "#7c9cff"},
        "encoding": {
          "x": {"field": "BIN_FIELD", "type": "ordinal", "title": "Bucket"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative", "title": "Count"},
          "tooltip": [{"field": "BIN_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "beeswarm",
      "name": "Beeswarm / Strip Plot",
      "use_when": "Showing every individual row's value across a category, keeping each point visible instead of collapsing to an aggregate",
      "data_shape": "numeric x, categorical y (jittered), optional size",
      "examples": ["LOC reviewed per engineer, every review as a point", "review duration per repository"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "transform": [{"calculate": "random()", "as": "jitter"}],
        "mark": {"type": "circle", "opacity": 0.85},
        "encoding": {
          "x": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "y": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "-x"},
          "yOffset": {"field": "jitter", "type": "quantitative"},
          "size": {"field": "SIZE_FIELD", "type": "quantitative", "scale": {"range": [60, 900]}},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "diverging_bar",
      "name": "Diverging Bar Chart",
      "use_when": "Comparing two roughly opposite quantities on either side of a zero line, per category",
      "data_shape": "numeric x (signed), categorical y, color = direction",
      "examples": ["upvotes vs downvotes per engineer", "LOC change per contributor, gain vs loss"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "y": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "x"},
          "x": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "color": {"field": "DIRECTION_FIELD", "type": "nominal", "legend": {"title": "Direction"},
                    "scale": {"domain": ["up", "down"], "range": ["#39d353", "#ff5c7c"]}},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}, {"field": "DIRECTION_FIELD"}]
        }
      }
    },
    {
      "id": "waterfall",
      "name": "Waterfall Chart",
      "use_when": "Showing a running total building up or down across named components",
      "data_shape": "nominal x (ordered components), base/top numeric segment y",
      "examples": ["cost saved vs cost incurred, broken into components", "cumulative LOC reviewed by stage"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "bar", "size": 60},
        "encoding": {
          "x": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": null, "title": null},
          "y": {"field": "BASE_FIELD", "type": "quantitative", "title": "Value"},
          "y2": {"field": "TOP_FIELD"},
          "color": {"field": "DIRECTION_FIELD", "type": "nominal", "legend": null,
                    "scale": {"domain": ["positive", "negative"], "range": ["#39d353", "#ff5c7c"]}},
          "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "TOP_FIELD"}]
        }
      }
    },
    {
      "id": "pareto",
      "name": "Pareto Chart",
      "use_when": "Showing concentration - how much of a total a ranked set of entities accounts for, cumulatively",
      "data_shape": "nominal x sorted by value descending, bar for the raw value, line for cumulative percent",
      "examples": ["how much of the org's activity the top contributors account for", "repositories by share of total LOC reviewed"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "layer": [
          {
            "mark": {"type": "bar", "color": "#7c9cff"},
            "encoding": {
              "x": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "-y"},
              "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
              "tooltip": [{"field": "CATEGORY_FIELD"}, {"field": "NUMERIC_FIELD"}]
            }
          },
          {
            "mark": {"type": "line", "point": true, "color": "#ff5c7c", "strokeWidth": 2},
            "encoding": {
              "x": {"field": "CATEGORY_FIELD", "type": "nominal", "sort": "-y"},
              "y": {"field": "CUMULATIVE_PCT_FIELD", "type": "quantitative", "title": "Cumulative %", "axis": {"orient": "right"}}
            }
          }
        ],
        "resolve": {"scale": {"y": "independent"}}
      }
    },
    {
      "id": "horizon",
      "name": "Horizon Graph",
      "use_when": "Showing a value changing over time, at a glance, over a long span - compact instead of a tall sparse line",
      "data_shape": "temporal x, the same numeric measure split into 2-3 clamped bands, rising opacity per band",
      "examples": ["LOC reviewed per day over 90+ days", "review volume over a long span"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "layer": [
          {"mark": {"type": "area", "color": "#7c9cff", "opacity": 0.35, "interpolate": "monotone"},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "BAND1_FIELD", "type": "quantitative"}}},
          {"mark": {"type": "area", "color": "#7c9cff", "opacity": 0.6, "interpolate": "monotone"},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "BAND2_FIELD", "type": "quantitative"}}},
          {"mark": {"type": "area", "color": "#7c9cff", "opacity": 1.0, "interpolate": "monotone"},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "BAND3_FIELD", "type": "quantitative"}}}
        ],
        "resolve": {"scale": {"y": "shared"}}
      }
    },
    {
      "id": "percentile_band",
      "name": "Percentile Band",
      "use_when": "Showing how confident/noisy a measure is over time, not just its center",
      "data_shape": "temporal x, low/high percentile band (errorband), median line on top",
      "examples": ["review turnaround time, median with p10-p90 band", "duration spread over time"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "layer": [
          {"mark": {"type": "errorband", "color": "#7c9cff", "opacity": 0.25},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "LOW_FIELD", "type": "quantitative"}, "y2": {"field": "HIGH_FIELD"}}},
          {"mark": {"type": "line", "color": "#ffb454", "strokeWidth": 2.5, "point": true},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "MEDIAN_FIELD", "type": "quantitative"}}}
        ]
      }
    },
    {
      "id": "calendar_heatmap",
      "name": "Calendar Heatmap",
      "use_when": "Showing a pattern of daily activity across a long window - a usage rhythm, habit, or consistency question",
      "data_shape": "day bucketed by week (x), day-of-week (y), numeric color",
      "examples": ["are engineers using the tool daily", "GitHub-style contribution graph of review activity"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "width": 900,
        "height": 130,
        "background": "#0d1117",
        "config": {
          "axis": {"labelColor": "#8b949e", "titleColor": "#e6ebf5", "labelFontSize": 10},
          "title": {"color": "#e6ebf5", "fontSize": 16, "anchor": "start"},
          "legend": {"labelColor": "#8b949e", "titleColor": "#e6ebf5"},
          "view": {"stroke": "transparent"}
        },
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "rect", "cornerRadius": 2},
        "encoding": {
          "x": {
            "field": "TIME_FIELD", "type": "ordinal", "timeUnit": "yearweek", "title": null,
            "scale": {"paddingInner": 0.15},
            "axis": {
              "format": "%b",
              "labelExpr": "date(datum.value) <= 7 ? timeFormat(datum.value, '%b') : ''",
              "labelAngle": 0, "ticks": false, "domain": false, "grid": false
            }
          },
          "y": {
            "field": "TIME_FIELD", "type": "ordinal", "timeUnit": "day", "title": null,
            "sort": ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"],
            "scale": {"paddingInner": 0.15},
            "axis": {"values": ["Mon", "Wed", "Fri"], "ticks": false, "domain": false, "grid": false}
          },
          "color": {
            "field": "NUMERIC_FIELD", "type": "quantitative", "title": null,
            "scale": {"type": "threshold", "domain": [1, 3, 6, 10], "range": ["#161b22", "#0e4429", "#006d32", "#26a641", "#39d353"]},
            "legend": null
          },
          "tooltip": [
            {"field": "TIME_FIELD", "type": "temporal", "title": "Date", "format": "%A, %b %d, %Y"},
            {"field": "NUMERIC_FIELD", "type": "quantitative"}
          ]
        }
      }
    },
    {
      "id": "slope_graph",
      "name": "Slope Graph",
      "use_when": "Comparing exactly two periods, one line per entity, to show who gained and who lost",
      "data_shape": "two nominal x points (period), numeric y, one line per entity via detail",
      "examples": ["repository velocity, previous period vs current", "reviewer activity, last month vs this month"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": {"type": "line", "point": true, "strokeWidth": 2.5},
        "encoding": {
          "x": {"field": "PERIOD_FIELD", "type": "nominal", "sort": ["Previous", "Current"], "title": null},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative"},
          "color": {"field": "GROUP_FIELD", "type": "nominal",
                    "scale": {"domain": ["gain", "flat", "loss"], "range": ["#39d353", "#8b949e", "#ff5c7c"]}},
          "detail": {"field": "ENTITY_FIELD", "type": "nominal"},
          "tooltip": [{"field": "ENTITY_FIELD"}, {"field": "PERIOD_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "dual_axis_line",
      "name": "Dual-Axis Line Chart",
      "use_when": "Showing whether two measures with different units are moving together over time",
      "data_shape": "temporal x, two numeric measures each on their own independent y axis",
      "examples": ["LOC reviewed vs review count over time", "cost vs usage over time"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "layer": [
          {"mark": {"type": "line", "color": "#ffb454", "strokeWidth": 2},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "NUMERIC_FIELD", "type": "quantitative", "axis": {"titleColor": "#ffb454"}}}},
          {"mark": {"type": "line", "color": "#7c9cff", "strokeWidth": 2},
           "encoding": {"x": {"field": "TIME_FIELD", "type": "temporal"}, "y": {"field": "NUMERIC_FIELD_2", "type": "quantitative", "axis": {"titleColor": "#7c9cff", "orient": "right"}}}}
        ],
        "resolve": {"scale": {"y": "independent"}}
      }
    },
    {
      "id": "stacked_bar_share",
      "name": "100%-Stacked Bar Over Time",
      "use_when": "Showing how the composition of a whole shifts over time, as a share of total per period",
      "data_shape": "temporal x, numeric y normalized to 100%, group color",
      "examples": ["trigger type share of reviews per week", "plan type mix over time"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "mark": "bar",
        "encoding": {
          "x": {"field": "TIME_FIELD", "type": "temporal"},
          "y": {"field": "NUMERIC_FIELD", "type": "quantitative", "stack": "normalize", "axis": {"format": "%"}},
          "color": {"field": "GROUP_FIELD", "type": "nominal"},
          "tooltip": [{"field": "TIME_FIELD"}, {"field": "GROUP_FIELD"}, {"field": "NUMERIC_FIELD"}]
        }
      }
    },
    {
      "id": "change_matrix",
      "name": "Change Matrix",
      "use_when": "Comparing several metrics across exactly two periods plus their delta, in one compact grid",
      "data_shape": "nominal x (period: W1/W2/Delta), nominal y (metric), color = value, text layer overlaying the number",
      "examples": ["what changed between week 1 and week 2, across several metrics at once"],
      "vega_lite_template": {
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": "DATA_PLACEHOLDER"},
        "layer": [
          {
            "mark": "rect",
            "encoding": {
              "x": {"field": "PERIOD_FIELD", "type": "nominal", "title": null},
              "y": {"field": "METRIC_FIELD", "type": "nominal", "title": null},
              "color": {"field": "NUMERIC_FIELD", "type": "quantitative", "scale": {"scheme": "redblue", "domainMid": 0}}
            }
          },
          {
            "mark": {"type": "text", "fontSize": 12},
            "encoding": {
              "x": {"field": "PERIOD_FIELD", "type": "nominal"},
              "y": {"field": "METRIC_FIELD", "type": "nominal"},
              "text": {"field": "DISPLAY_VALUE_FIELD"}
            }
          }
        ]
      }
    }
  ]
}
