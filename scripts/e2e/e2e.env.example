# Copy to .env.e2e.local at the repository root, chmod 600, and edit.
# Never commit the real file. `.env.*` is git-ignored.

# The real account must already be a super admin in one org and an owner in
# another (or set E2E_OWNER_ORG_ID / E2E_SUPER_ORG_ID explicitly).
E2E_EMAIL=you@example.com

# Optional: local /admin password. When set, auth is non-interactive.
# When unset, `make e2e-auth` opens the browser for Hexmos SSO (the fixed
# local OTP works there).
E2E_PASSWORD=

# Browser/SSO fallback. This is a credential: keep it only in this local file.
E2E_OTP=

# Local dev server (default) or a public manual-talent target.
E2E_BASE_URL=http://localhost:8081
E2E_API_URL=http://localhost:8888

# Optional explicit org override; normally discovered from the cached session.
E2E_OWNER_ORG_ID=
E2E_SUPER_ORG_ID=
E2E_OTHER_ORG_ID=

# Optional capability controls. Set to 1 to skip external calls.
E2E_SKIP_AI=0
E2E_SKIP_GIT=0

# Default launch target for `make dev-up`; use niceurl3 for manual-talent3.
NICEURL=niceurl2
